<Window x:Class="RealmLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RealmLauncher.Views"
        Title="REALM RolePlay Launcher"
        Width="1100"
        Height="700"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{DynamicResource AppFont}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Background="Transparent">

    <Border x:Name="WindowShell"
            CornerRadius="16"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Grid ClipToBounds="True">
            <Rectangle Fill="{DynamicResource WindowGlowBrush}" IsHitTestVisible="False"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="68"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="58"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}">
                    <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1">
                        <Grid x:Name="HeaderBar"
                              Background="Transparent"
                              Margin="20,0,14,0"
                              MouseLeftButtonDown="HeaderBar_OnMouseLeftButtonDown">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Image x:Name="imgLogo"
                                   Grid.Column="0"
                                   Height="38"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Left"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <Border Grid.Column="1"
                                    Margin="14,0,0,0"
                                    VerticalAlignment="Center"
                                    CornerRadius="7"
                                    Padding="9,3"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource StrokeBrush}"
                                    BorderThickness="1">
                                <TextBlock x:Name="txtLauncherVersion"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11.5"
                                           FontWeight="Medium"
                                           Text="v0.0.0.0"/>
                            </Border>

                            <Border Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"
                                    CornerRadius="12"
                                    Padding="3"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource StrokeBrush}"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="btnNavMain"
                                            Content="Главная"
                                            Style="{DynamicResource NavButtonStyle}"
                                            Click="BtnNavMain_OnClick"/>
                                    <Button x:Name="btnNavSettings"
                                            Content="Настройки"
                                            Margin="3,0,0,0"
                                            Style="{DynamicResource NavButtonStyle}"
                                            Click="BtnNavSettings_OnClick"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="btnMinimizeApp"
                                        ToolTip="Свернуть"
                                        Style="{DynamicResource WindowButtonStyle}"
                                        Click="BtnMinimizeApp_OnClick">
                                    <Rectangle Width="11" Height="1.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>
                                <Button x:Name="btnCloseApp"
                                        Margin="4,0,0,0"
                                        ToolTip="Закрыть"
                                        Style="{DynamicResource CloseWindowButtonStyle}"
                                        Click="BtnCloseApp_OnClick">
                                    <Path Width="11"
                                          Height="11"
                                          Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M 0 0 L 10 10 M 10 0 L 0 10"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>

                <Grid Grid.Row="1" Margin="20,18,20,10">

                    <Grid x:Name="MainPageGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="398"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{DynamicResource CardStyle}">
                            <Grid Margin="18,15,18,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Новости обновлений" Style="{DynamicResource PageTitleStyle}" FontSize="21"/>
                                        <TextBlock x:Name="txtNewsSubtitle"
                                                   Margin="0,2,0,0"
                                                   Text="Свежее из мира REALM RP"
                                                   Style="{DynamicResource HintTextStyle}"/>
                                    </StackPanel>
                                    <Button x:Name="btnRefreshNews"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Height="32"
                                            Padding="14,0"
                                            Content="Обновить"
                                            ToolTip="Перезагрузить ленту новостей"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            Click="BtnRefreshNews_OnClick"/>
                                </Grid>

                                <Border Grid.Row="1" Style="{DynamicResource WellStyle}">
                                    <RichTextBox x:Name="rtbNewsBox"
                                                 Margin="6,8,4,8"
                                                 IsReadOnly="True"
                                                 IsDocumentEnabled="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                                 SelectionBrush="{DynamicResource AccentBrush}"
                                                 FontSize="13.2"
                                                 Padding="8,4"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{DynamicResource CardStyle}">
                                <StackPanel Margin="18,14,18,15">
                                    <TextBlock Text="СЕРВЕР" Style="{DynamicResource CardTitleStyle}"/>

                                    <Grid Margin="0,10,0,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="serverStatusDot"
                                                     Width="9"
                                                     Height="9"
                                                     VerticalAlignment="Center"
                                                     Fill="{DynamicResource WarningBrush}"/>
                                            <TextBlock x:Name="lblServerStatusText"
                                                       Margin="9,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="Проверка..."/>
                                        </StackPanel>
                                        <TextBlock x:Name="lblPlayersCount"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Text="--/--"/>
                                    </Grid>

                                    <Rectangle Height="1"
                                               Margin="0,13,0,0"
                                               Fill="{DynamicResource StrokeBrush}"/>

                                    <Grid Margin="0,11,0,0">
                                        <TextBlock Text="Steam"
                                                   VerticalAlignment="Center"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock x:Name="lblSteamCmdStatus"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontSize="12.5"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="неизвестно"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Style="{DynamicResource CardStyle}">
                                <StackPanel Margin="18,14,18,18">
                                    <TextBlock Text="ПОДКЛЮЧЕНИЕ" Style="{DynamicResource CardTitleStyle}"/>

                                    <TextBlock Text="Пароль сервера"
                                               Margin="0,12,0,6"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <PasswordBox x:Name="txtServerPasswordInput"
                                                 Style="{DynamicResource PasswordInputStyle}"/>

                                    <Button x:Name="btnPlayMain"
                                            Margin="0,14,0,0"
                                            Content="ЗАПУСК ИГРЫ"
                                            Style="{DynamicResource PrimaryButtonStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="4" Style="{DynamicResource CardStyle}">
                                <Grid Margin="18,14,18,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <TextBlock Text="ЖУРНАЛ" Style="{DynamicResource CardTitleStyle}" VerticalAlignment="Center"/>
                                        <Button x:Name="btnClearLog"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Height="26"
                                                Padding="10,0"
                                                FontSize="11.5"
                                                Content="Очистить"
                                                Style="{DynamicResource SecondaryButtonStyle}"
                                                Click="BtnClearLog_OnClick"/>
                                    </Grid>

                                    <Border Grid.Row="1" Style="{DynamicResource WellStyle}">
                                        <Grid>
                                            <TextBlock x:Name="txtLogPlaceholder"
                                                       Margin="16,14,16,0"
                                                       VerticalAlignment="Top"
                                                       Style="{DynamicResource HintTextStyle}"
                                                       Text="Здесь появится ход запуска: проверка Steam, синхронизация модов и подключение к серверу."/>
                                            <TextBox x:Name="txtLogBox" Style="{DynamicResource LogTextBoxStyle}"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <views:SettingsPageView x:Name="SettingsPage" Visibility="Collapsed"/>
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource FooterBrush}">
                    <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0">
                        <Grid Margin="20,0,20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="btnDiscord"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Content="Discord"
                                    ToolTip="Открыть приглашение в Discord"
                                    Style="{DynamicResource AccentGhostButtonStyle}"/>

                            <TextBlock x:Name="lblStatus"
                                       Grid.Column="2"
                                       VerticalAlignment="Center"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Ожидание..."
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <ProgressBar x:Name="progressMods"
                                             Width="240"
                                             VerticalAlignment="Center"
                                             Minimum="0"
                                             Maximum="1000"
                                             Value="0"
                                             Style="{DynamicResource RealmProgressBarStyle}"/>
                                <TextBlock x:Name="lblProgressPercent"
                                           Width="42"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"
                                           FontSize="12.5"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="0%"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
