<Window x:Class="RealmLauncher.Ui.DualInstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="REALM RolePlay Launcher"
        Width="560"
        SizeToContent="Height"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource AppFont}"
        Background="Transparent">

    <Border CornerRadius="16"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBrush}"
                    CornerRadius="15,15,0,0">
                <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1">
                    <Grid Height="52"
                          Margin="18,0,10,0"
                          Background="Transparent"
                          MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                        <TextBlock Margin="0,0,44,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="14.5"
                                   FontWeight="Bold"
                                   Text="Две версии игры рядом"/>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{DynamicResource CloseWindowButtonStyle}"
                                Click="BtnClose_OnClick">
                            <Path Width="10"
                                  Height="10"
                                  Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 0 0 L 10 10 M 10 0 L 0 10"/>
                        </Button>
                    </Grid>
                </Border>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,18,20,18">
                <TextBlock x:Name="txtTitle"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="16"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Text="Что это даёт"/>

                <TextBlock x:Name="txtBody"
                           Margin="0,10,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="13.5"
                           LineHeight="20"
                           TextWrapping="Wrap"/>

                <Grid x:Name="pathsGrid" Margin="0,14,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="txtFirstLabel"
                               Grid.Row="0" Grid.Column="0"
                               Margin="0,0,10,6"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="Enhanced:"/>
                    <TextBlock x:Name="txtFirstPath"
                               Grid.Row="0" Grid.Column="1"
                               Margin="0,0,0,6"
                               FontSize="12.5"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <TextBlock x:Name="txtSecondLabel"
                               Grid.Row="1" Grid.Column="0"
                               Margin="0,0,10,0"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="Legacy:"/>
                    <TextBlock x:Name="txtSecondPath"
                               Grid.Row="1" Grid.Column="1"
                               FontSize="12.5"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Grid>

                <Border x:Name="noteBorder"
                        Margin="0,14,0,0"
                        Padding="12,10"
                        CornerRadius="8"
                        Visibility="Collapsed"
                        Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1">
                    <TextBlock x:Name="txtNote"
                               FontSize="12.5"
                               LineHeight="18"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource AccentBrush}"/>
                </Border>

                <TextBlock x:Name="txtError"
                           Margin="0,12,0,0"
                           FontSize="12.5"
                           LineHeight="18"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Foreground="{DynamicResource DangerBrush}"/>
            </StackPanel>

            <Border Grid.Row="2"
                    Background="{DynamicResource FooterBrush}"
                    CornerRadius="0,0,15,15">
                <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="18,14,18,14">
                        <Button x:Name="btnSecondary"
                                MinWidth="104"
                                Height="38"
                                Content="Закрыть"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Click="BtnClose_OnClick"/>
                        <Button x:Name="btnPrimary"
                                MinWidth="128"
                                Height="38"
                                Margin="10,0,0,0"
                                Content="Начать"
                                IsDefault="True"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Click="BtnPrimary_OnClick"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
