<Window x:Class="RealmLauncher.Ui.RealmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="REALM RolePlay Launcher"
        Width="520"
        SizeToContent="Height"
        MinHeight="200"
        MaxHeight="580"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource AppFont}"
        Background="Transparent">

    <Border CornerRadius="16"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBrush}"
                    CornerRadius="15,15,0,0">
                <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1">
                    <Grid Height="52"
                          Margin="18,0,10,0"
                          Background="Transparent"
                          MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                        <TextBlock x:Name="txtTitle"
                                   Margin="0,0,44,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="14.5"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"
                                   Text="Сообщение"/>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{DynamicResource CloseWindowButtonStyle}"
                                Click="BtnClose_OnClick">
                            <Path Width="10"
                                  Height="10"
                                  Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 0 0 L 10 10 M 10 0 L 0 10"/>
                        </Button>
                    </Grid>
                </Border>
            </Border>

            <Grid Grid.Row="1" Margin="20,20,20,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="iconCircle"
                        Width="40"
                        Height="40"
                        CornerRadius="12"
                        VerticalAlignment="Top"
                        Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1">
                    <TextBlock x:Name="txtIcon"
                               Text="i"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <ScrollViewer Grid.Column="2"
                              MaxHeight="360"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,1,0,0">
                    <TextBlock x:Name="txtMessage"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13.5"
                               LineHeight="20"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource FooterBrush}"
                    CornerRadius="0,0,15,15">
                <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="18,14,18,14">
                        <Button x:Name="btnNo"
                                MinWidth="104"
                                Content="Нет"
                                Visibility="Collapsed"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Click="BtnNo_OnClick"/>
                        <Button x:Name="btnYes"
                                MinWidth="104"
                                Height="38"
                                Margin="10,0,0,0"
                                Content="Да"
                                Visibility="Collapsed"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Click="BtnYes_OnClick"/>
                        <Button x:Name="btnOk"
                                MinWidth="104"
                                Height="38"
                                Content="OK"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Click="BtnOk_OnClick"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
