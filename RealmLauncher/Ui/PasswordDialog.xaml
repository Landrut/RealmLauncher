<Window x:Class="RealmLauncher.Ui.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="REALM RolePlay Launcher"
        Width="470"
        SizeToContent="Height"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource AppFont}"
        Background="Transparent">

    <Border CornerRadius="16"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBrush}"
                    CornerRadius="15,15,0,0">
                <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1">
                    <Grid Height="52"
                          Margin="18,0,10,0"
                          Background="Transparent"
                          MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                        <TextBlock Margin="0,0,44,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="14.5"
                                   FontWeight="Bold"
                                   Text="Пароль сервера"/>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{DynamicResource CloseWindowButtonStyle}"
                                Click="BtnCancel_OnClick">
                            <Path Width="10"
                                  Height="10"
                                  Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 0 0 L 10 10 M 10 0 L 0 10"/>
                        </Button>
                    </Grid>
                </Border>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,18,20,18">
                <TextBlock x:Name="txtMessage"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="13.5"
                           LineHeight="20"
                           TextWrapping="Wrap"
                           Text="Сервер защищён паролем. Введите его, чтобы продолжить."/>

                <PasswordBox x:Name="txtPassword"
                             Margin="0,14,0,0"
                             Style="{DynamicResource PasswordInputStyle}"/>

                <TextBlock x:Name="txtError"
                           Margin="0,8,0,0"
                           FontSize="12.5"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Foreground="{DynamicResource DangerBrush}"/>
            </StackPanel>

            <Border Grid.Row="2"
                    Background="{DynamicResource FooterBrush}"
                    CornerRadius="0,0,15,15">
                <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="18,14,18,14">
                        <Button MinWidth="104"
                                Height="38"
                                Content="Отмена"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Click="BtnCancel_OnClick"/>
                        <Button x:Name="btnOk"
                                MinWidth="104"
                                Height="38"
                                Margin="10,0,0,0"
                                Content="Подключиться"
                                IsDefault="True"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Click="BtnOk_OnClick"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
