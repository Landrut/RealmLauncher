<UserControl x:Class="RealmLauncher.Views.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1060"
             d:DesignHeight="560"
             FontFamily="{DynamicResource AppFont}"
             Background="Transparent">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{DynamicResource CardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4,4,4,4">
                <StackPanel Margin="18,13,14,16">
                    <TextBlock Text="Настройки" Style="{DynamicResource PageTitleStyle}" FontSize="21"/>
                    <TextBlock Text="Игра, Steam и оформление лаунчера"
                               Margin="0,2,0,0"
                               Style="{DynamicResource HintTextStyle}"/>

                    <Border Style="{DynamicResource WellStyle}" Margin="0,16,0,0">
                        <StackPanel Margin="16,14,16,16">
                            <TextBlock Text="ИГРА" Style="{DynamicResource CardTitleStyle}"/>

                            <Grid Margin="0,10,0,0">
                                <TextBlock Text="Путь к Conan Exiles"
                                           VerticalAlignment="Center"
                                           FontSize="13.5"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Border x:Name="branchBadge" x:FieldModifier="public"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        CornerRadius="5"
                                        Padding="7,2"
                                        Visibility="Collapsed"
                                        Background="{DynamicResource AccentSoftBrush}">
                                    <TextBlock x:Name="txtBranchBadge" x:FieldModifier="public"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Text="ENHANCED"/>
                                </Border>
                            </Grid>

                            <TextBlock x:Name="txtGameHint" x:FieldModifier="public"
                                       Text="Лаунчер находит игру через Steam автоматически."
                                       Margin="0,4,0,0"
                                       Style="{DynamicResource HintTextStyle}"/>

                            <TextBox x:Name="txtConanExe" x:FieldModifier="public"
                                     Margin="0,10,0,0"
                                     Style="{DynamicResource PathDisplayStyle}"
                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="btnDetectGame" x:FieldModifier="public"
                                        Height="36"
                                        Padding="16,0"
                                        Content="Найти автоматически"
                                        Style="{DynamicResource SecondaryButtonStyle}"/>
                                <Button x:Name="btnBrowseConanExe" x:FieldModifier="public"
                                        Height="36"
                                        Margin="8,0,0,0"
                                        Padding="16,0"
                                        Content="Указать вручную"
                                        Style="{DynamicResource SecondaryButtonStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource WellStyle}" Margin="0,12,0,0">
                        <StackPanel Margin="16,14,16,16">
                            <TextBlock Text="ОФОРМЛЕНИЕ" Style="{DynamicResource CardTitleStyle}"/>
                            <TextBlock Text="Тема лаунчера"
                                       Margin="0,10,0,8"
                                       FontSize="13.5"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <StackPanel x:Name="themeOptions" x:FieldModifier="public"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource WellStyle}" Margin="0,12,0,0">
                        <StackPanel Margin="16,14,16,16">
                            <TextBlock Text="STEAM" Style="{DynamicResource CardTitleStyle}"/>
                            <TextBlock Text="Клиент Steam должен быть запущен и авторизован — через него скачиваются моды."
                                       Margin="0,10,0,0"
                                       Style="{DynamicResource HintTextStyle}"/>
                            <Button x:Name="btnCheckSteamCmd" x:FieldModifier="public"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Left"
                                    Padding="18,0"
                                    Content="Проверить / Запустить"
                                    Style="{DynamicResource SecondaryButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource WellStyle}" Margin="0,12,0,0">
                        <StackPanel Margin="16,14,16,16">
                            <TextBlock Text="ОБНОВЛЕНИЯ" Style="{DynamicResource CardTitleStyle}"/>
                            <TextBlock Text="Лаунчер проверяет обновления при запуске. Здесь можно проверить вручную."
                                       Margin="0,10,0,0"
                                       Style="{DynamicResource HintTextStyle}"/>
                            <Button x:Name="btnCheckUpdates" x:FieldModifier="public"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Left"
                                    Padding="18,0"
                                    Content="Проверить обновление"
                                    Style="{DynamicResource SecondaryButtonStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="2" Style="{DynamicResource CardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4,4,4,4">
                <StackPanel Margin="18,13,14,16">
                    <TextBlock Text="Дополнительно" Style="{DynamicResource PageTitleStyle}" FontSize="21"/>
                    <TextBlock Text="Как лаунчер ведёт себя при запуске игры и Windows"
                               Margin="0,2,0,0"
                               Style="{DynamicResource HintTextStyle}"/>

                    <Border Style="{DynamicResource WellStyle}" Margin="0,16,0,0">
                        <StackPanel Margin="16,14,16,15">
                            <CheckBox x:Name="chkAutoSubscribe" x:FieldModifier="public"
                                      Style="{DynamicResource RealmToggleStyle}"
                                      IsChecked="True"
                                      Content="Авто-подписка на моды Workshop"/>
                            <TextBlock Margin="0,8,54,0"
                                       Style="{DynamicResource HintTextStyle}"
                                       Text="Автоматически подписывает аккаунт Steam на моды из списка сервера перед запуском."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource WellStyle}" Margin="0,12,0,0">
                        <StackPanel Margin="16,14,16,15">
                            <CheckBox x:Name="chkBattlEye" x:FieldModifier="public"
                                      Style="{DynamicResource RealmToggleStyle}"
                                      Content="Запускать с BattlEye"/>
                            <TextBlock Margin="0,8,54,0"
                                       Style="{DynamicResource HintTextStyle}"
                                       Text="Сейчас сервер не требует BattlEye. Включайте, только если это понадобится."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource WellStyle}" Margin="0,12,0,0">
                        <StackPanel Margin="16,14,16,15">
                            <CheckBox x:Name="chkDiscordStatus" x:FieldModifier="public"
                                      Style="{DynamicResource RealmToggleStyle}"
                                      IsChecked="True"
                                      Content="Показывать статус в Discord"/>
                            <TextBlock Margin="0,8,54,0"
                                       Style="{DynamicResource HintTextStyle}"
                                       Text="Друзья увидят в вашем профиле Discord, что вы играете на REALM RolePlay."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource WellStyle}" Margin="0,12,0,0">
                        <StackPanel Margin="16,14,16,15">
                            <CheckBox x:Name="chkNotifyOnline" x:FieldModifier="public"
                                      Style="{DynamicResource RealmToggleStyle}"
                                      IsChecked="True"
                                      Content="Сообщать, когда сервер поднялся"/>
                            <TextBlock Margin="0,8,54,0"
                                       Style="{DynamicResource HintTextStyle}"
                                       Text="Если сервер был недоступен и снова вернулся в онлайн, лаунчер покажет уведомление."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource WellStyle}" Margin="0,12,0,0">
                        <StackPanel Margin="16,14,16,15">
                            <CheckBox x:Name="chkAutoStart" x:FieldModifier="public"
                                      Style="{DynamicResource RealmToggleStyle}"
                                      Content="Запускать вместе с Windows"/>
                            <TextBlock Margin="0,8,54,0"
                                       Style="{DynamicResource HintTextStyle}"
                                       Text="Лаунчер добавится в автозапуск текущего пользователя."/>

                            <CheckBox x:Name="chkStartMinimized" x:FieldModifier="public"
                                      Margin="0,14,0,0"
                                      Style="{DynamicResource RealmToggleStyle}"
                                      Content="Запускать свёрнутым"/>
                            <TextBlock Margin="0,8,54,0"
                                       Style="{DynamicResource HintTextStyle}"
                                       Text="Окно не будет открываться на весь экран при автозапуске."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource WellStyle}" Margin="0,12,0,0">
                        <StackPanel Margin="16,14,16,15">
                            <CheckBox x:Name="chkDeveloperMode" x:FieldModifier="public"
                                      Style="{DynamicResource RealmToggleStyle}"
                                      Content="Режим разработчика"/>
                            <TextBlock Margin="0,8,54,0"
                                       Style="{DynamicResource HintTextStyle}"
                                       Text="Открывает во вкладке «Моды» ручное добавление модов, изменение порядка загрузки, импорт и экспорт списка и локальный запуск игры. Обычным игрокам не нужен."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource WellStyle}" Margin="0,12,0,0">
                        <StackPanel Margin="16,14,16,15">
                            <TextBlock Text="ПАМЯТКА" Style="{DynamicResource CardTitleStyle}"/>
                            <TextBlock Margin="0,10,0,0"
                                       Style="{DynamicResource HintTextStyle}"
                                       Text="Настройки сохраняются автоматически. Лаунчер прописывает адрес сервера в конфиг игры и запускает её сразу с подключением — заходить через список серверов не нужно."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
