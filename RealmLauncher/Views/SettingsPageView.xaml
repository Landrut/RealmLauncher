<UserControl x:Class="RealmLauncher.Views.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1060"
             d:DesignHeight="560"
             FontFamily="{DynamicResource AppFont}"
             Background="Transparent">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{DynamicResource CardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4,4,4,4">
                <StackPanel Margin="18,13,14,16">
                    <TextBlock Text="Настройки" Style="{DynamicResource PageTitleStyle}" FontSize="21"/>
                    <TextBlock Text="Пути, Steam и обновления лаунчера"
                               Margin="0,2,0,0"
                               Style="{DynamicResource HintTextStyle}"/>

                    <Border Style="{DynamicResource WellStyle}" Margin="0,16,0,0">
                        <StackPanel Margin="16,14,16,16">
                            <TextBlock Text="ИГРА" Style="{DynamicResource CardTitleStyle}"/>
                            <TextBlock Text="Путь к ConanSandbox.exe"
                                       Margin="0,10,0,0"
                                       FontSize="13.5"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Лаунчер использует его, чтобы найти папку игры, моды и modlist.txt."
                                       Margin="0,4,0,0"
                                       Style="{DynamicResource HintTextStyle}"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtConanExe" x:FieldModifier="public"
                                         Grid.Column="0"
                                         Style="{DynamicResource PathDisplayStyle}"
                                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                <Button x:Name="btnBrowseConanExe" x:FieldModifier="public"
                                        Grid.Column="2"
                                        Height="38"
                                        Padding="18,0"
                                        Content="Обзор"
                                        Style="{DynamicResource SecondaryButtonStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource WellStyle}" Margin="0,12,0,0">
                        <StackPanel Margin="16,14,16,16">
                            <TextBlock Text="ОФОРМЛЕНИЕ" Style="{DynamicResource CardTitleStyle}"/>
                            <TextBlock Text="Тема лаунчера"
                                       Margin="0,10,0,8"
                                       FontSize="13.5"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <StackPanel x:Name="themeOptions" x:FieldModifier="public"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource WellStyle}" Margin="0,12,0,0">
                        <StackPanel Margin="16,14,16,16">
                            <TextBlock Text="STEAM" Style="{DynamicResource CardTitleStyle}"/>
                            <TextBlock Text="Клиент Steam должен быть запущен и авторизован — через него скачиваются моды."
                                       Margin="0,10,0,0"
                                       Style="{DynamicResource HintTextStyle}"/>
                            <Button x:Name="btnCheckSteamCmd" x:FieldModifier="public"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Left"
                                    Padding="18,0"
                                    Content="Проверить / Запустить"
                                    Style="{DynamicResource SecondaryButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource WellStyle}" Margin="0,12,0,0">
                        <StackPanel Margin="16,14,16,16">
                            <TextBlock Text="ОБНОВЛЕНИЯ" Style="{DynamicResource CardTitleStyle}"/>
                            <TextBlock Text="Лаунчер проверяет обновления при запуске. Здесь можно проверить вручную."
                                       Margin="0,10,0,0"
                                       Style="{DynamicResource HintTextStyle}"/>
                            <Button x:Name="btnCheckUpdates" x:FieldModifier="public"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Left"
                                    Padding="18,0"
                                    Content="Проверить обновление"
                                    Style="{DynamicResource SecondaryButtonStyle}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="2" Style="{DynamicResource CardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4,4,4,4">
                <StackPanel Margin="18,13,14,16">
                    <TextBlock Text="Дополнительно" Style="{DynamicResource PageTitleStyle}" FontSize="21"/>
                    <TextBlock Text="Опции, которые лаунчер применяет перед запуском игры"
                               Margin="0,2,0,0"
                               Style="{DynamicResource HintTextStyle}"/>

                    <Border Style="{DynamicResource WellStyle}" Margin="0,16,0,0">
                        <StackPanel Margin="16,14,16,15">
                            <CheckBox x:Name="chkDisableIntro" x:FieldModifier="public"
                                      Style="{DynamicResource RealmToggleStyle}"
                                      Content="Отключить вступительный ролик"/>
                            <TextBlock Margin="0,8,54,0"
                                       Style="{DynamicResource HintTextStyle}"
                                       Text="Заменяет вступительный ролик Conan Exiles на чёрный экран при загрузке игры."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource WellStyle}" Margin="0,12,0,0">
                        <StackPanel Margin="16,14,16,15">
                            <CheckBox x:Name="chkAutoSubscribe" x:FieldModifier="public"
                                      Style="{DynamicResource RealmToggleStyle}"
                                      IsChecked="True"
                                      Content="Авто-подписка на моды Workshop"/>
                            <TextBlock Margin="0,8,54,0"
                                       Style="{DynamicResource HintTextStyle}"
                                       Text="Автоматически подписывает аккаунт Steam на моды из списка сервера перед запуском."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource WellStyle}" Margin="0,12,0,0">
                        <StackPanel Margin="16,14,16,15">
                            <CheckBox x:Name="chkBoostLoading" x:FieldModifier="public"
                                      Style="{DynamicResource RealmToggleStyle}"
                                      IsChecked="True"
                                      Content="Ускорить внутриигровые загрузки"/>
                            <TextBlock Margin="0,8,54,0"
                                       Style="{DynamicResource HintTextStyle}"
                                       Text="Меняет ConfiguredInternetSpeed и ConfiguredLanSpeed в BaseEngine.ini: 250000 (вкл) / 10000 (выкл). Существенно ускоряет прогрузку локаций."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource WellStyle}" Margin="0,12,0,0">
                        <StackPanel Margin="16,14,16,15">
                            <TextBlock Text="ПАМЯТКА" Style="{DynamicResource CardTitleStyle}"/>
                            <TextBlock Margin="0,10,0,0"
                                       Style="{DynamicResource HintTextStyle}"
                                       Text="Изменения сохраняются автоматически. Перед первым запуском укажите путь к ConanSandbox.exe и запустите Steam."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
